# Nexus Wallet key proxy — copy to .env and fill in. Never commit .env.
# Bind to 127.0.0.1 for local/dev; only expose publicly behind TLS + auth.
PROXY_HOST=127.0.0.1
PROXY_PORT=8787

# Optional browser CORS origin (mobile clients do not need this).
# PROXY_ALLOW_ORIGIN=

# Limits
PROXY_MAX_BODY_BYTES=262144
PROXY_MAX_RESPONSE_BYTES=8388608
UPSTREAM_TIMEOUT_MS=20000

# Provider keys. lifi/rango/dodo work keyless; leave blank if unused.
LIFI_API_KEY=
ODOS_API_KEY=
ONEINCH_API_KEY=
ENSO_API_KEY=
RANGO_API_KEY=
SQUID_INTEGRATOR_ID=
DODO_API_KEY=
NANSEN_API_KEY=

# OKX DEX requires all three (HMAC-SHA256 signing happens server-side).
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
