{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "types": ["react"],
    "baseUrl": ".",
    "paths": {
      "@nexus/core": ["../core/src/index.ts"],
      "@nexus/core/*": ["../core/src/*"]
    }
  },
  "include": ["src"]
}
